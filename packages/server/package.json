{
	"name": "server",
	"version": "1.0.0",
	"description": "MemoNote backend",
	"author": "yyc",
	"license": "MIT",
	"main": "dist/index.mjs",
	"private": true,
	"scripts": {
		"build": "prisma generate && tsc && tsup",
		"start:dev": "NODE_ENV=development tsx watch src/index.ts",
		"start:prod": "node dist/index.mjs",
		"check": "biome check --write",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:seed": "prisma generate && NODE_ENV=development tsx prisma/seed.ts",
		"db:studio": "prisma studio",
		"test": "vitest run",
		"test:cov": "vitest run --coverage"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "7.3.4",
		"@prisma/adapter-mariadb": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"cors": "2.8.6",
		"dotenv": "17.3.1",
		"express": "5.2.1",
		"express-rate-limit": "8.3.1",
		"helmet": "8.1.0",
		"http-status-codes": "2.3.0",
		"jose": "^6.2.5",
		"pino": "9.14.0",
		"pino-http": "10.5.0",
		"swagger-ui-express": "5.0.1",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.9",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.3",
		"@types/node": "^26.1.2",
		"@types/supertest": "6.0.3",
		"@types/swagger-ui-express": "4.1.8",
		"@vitest/coverage-v8": "3.2.4",
		"pino-pretty": "13.1.3",
		"prisma": "^7.9.1",
		"supertest": "7.1.4",
		"tsup": "8.5.1",
		"tsx": "4.21.0",
		"typescript": "5.9.2",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.4"
	},
	"tsup": {
		"entry": [
			"src/index.ts"
		],
		"outDir": "dist",
		"format": [
			"esm"
		],
		"target": "es2020",
		"sourcemap": true,
		"clean": true,
		"dts": true,
		"splitting": false,
		"skipNodeModulesBundle": true
	},
	"packageManager": "pnpm@10.33.0"
}
